{
  "name": "tyranitar-capim-dourado",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/gerar-tokens.mjs",
    "predev": "npm run tokens",
    "dev": "vite",
    "dev:api": "npm run build && wrangler pages dev",
    "prebuild": "npm run tokens",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unidade": "vitest run tests/unidade",
    "seed": "node scripts/gerar-seed.mjs",
    "db:migrar": "wrangler d1 migrations apply tyranitar --local",
    "db:migrar:remoto": "wrangler d1 migrations apply tyranitar --remote"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.161.0"
  }
}
